# Database (PostgreSQL connection string; placeholder only — never commit real secrets)
DATABASE_URL="postgresql://user:password@localhost:5432/campus_dev?schema=public"
# Auth.js secret (placeholder only — generate one with: npx auth secret)
AUTH_SECRET="replace-me-with-a-generated-secret"
# Google OAuth (optional, fail-soft — leave empty to disable "Continue with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Admin login (separate from user accounts; no User.role, no new tables).
# Signed with the existing AUTH_SECRET above (documented reuse — no second
# secret). Generate the hash with (verified command; argv[1], no top-level
# await under tsx -e):
#   npx tsx -e "import bcrypt from 'bcryptjs'; bcrypt.hash(process.argv[1], 12).then((h) => console.log(h));" "<admin-password>"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
